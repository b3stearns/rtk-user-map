{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/sheets.js", "use": "@vercel/node" },
    { "src": "api/bases.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/sheets", "dest": "/api/sheets.js" },
    { "src": "/api/bases", "dest": "/api/bases.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
